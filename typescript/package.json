{
  "name": "@memoclaw/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the MemoClaw memory API",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools.js",
      "types": "./dist/tools.d.ts"
    },
    "./langchain": {
      "import": "./dist/integrations/langchain.js",
      "types": "./dist/integrations/langchain.d.ts"
    },
    "./vercel-ai": {
      "import": "./dist/integrations/vercel-ai.js",
      "types": "./dist/integrations/vercel-ai.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "memoclaw",
    "memory",
    "ai",
    "sdk",
    "semantic-search"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "MemoClaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/anajuliabit/memoclaw-sdk",
    "directory": "typescript"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^1.9.0"
  },
  "dependencies": {
    "viem": "^2.46.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
